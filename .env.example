# class-app web: every environment variable it reads, with example values.
#
# This file is a reference only; nothing loads it. The npm scripts load:
#   npm run dev                      .env.dev
#   npm run build / build:prod       .env.prod
#   npm run build:uat                .env.uat
# Real environment variables override the file. Local overrides: .env.<env>.local (git-ignored).
#
# Everything NEXT_PUBLIC_* is built into the pages and visible to anyone: never put a secret in it.

# ---------------------------------------------------------------------------------------------
# The class-app server
# ---------------------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------------------------
# Admin console single sign-on (optional; the console also offers username/password sign-in)
# ---------------------------------------------------------------------------------------------
# Leave the issuer empty to hide "Sign in with SSO". Register <web origin>/admin/callback as a
# redirect URI for this public client with your provider.
NEXT_PUBLIC_OIDC_ISSUER=https://sso.example.com/realms/classapp
NEXT_PUBLIC_OIDC_CLIENT_ID=classapp-admin-console
NEXT_PUBLIC_OIDC_SCOPE=openid profile
NEXT_PUBLIC_OIDC_AUDIENCE=
# Must match the server's CLASSAPP_OIDC_ROLES_CLAIM and CLASSAPP_OIDC_TENANT_CLAIM.
NEXT_PUBLIC_OIDC_ROLES_CLAIM=roles
NEXT_PUBLIC_OIDC_TENANT_CLAIM=tenant_id

# ---------------------------------------------------------------------------------------------
# Development scripts only (npm run dev:launch, npm run dev:idp); not used by the app itself
# ---------------------------------------------------------------------------------------------
# Where dev:launch creates the Demo School and where its join links point.
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
# The server's admin key, used by dev:launch to enrol the Demo School.
CLASSAPP_ADMIN_API_KEY=dev-admin-key
# Port of the development identity provider (dev:idp).
DEV_IDP_PORT=9400
