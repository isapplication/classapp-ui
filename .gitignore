# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
playwright-report/
test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: .env.dev, .env.uat and .env.prod are committed (public values only, no secrets);
# per-machine overrides are not.
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MediaPipe WebAssembly, copied from node_modules by scripts/copy-mediapipe.mjs
/public/mediapipe

# Demo School keys saved by `npm run dev:launch` (local only).
.demo-school.local.json

# Generated by `next dev` — not part of the source tree.
AGENTS.md
