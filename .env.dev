# class-app web — DEVELOPMENT. Loaded by `npm run dev`. Nothing here is secret.
# NEXT_PUBLIC_* values are built into the pages. Local overrides: .env.dev.local (ignored).

# The class-app server.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Admin console single sign-on: the development identity provider (npm run dev:idp).
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:9400
NEXT_PUBLIC_OIDC_CLIENT_ID=classapp-admin-console
NEXT_PUBLIC_OIDC_SCOPE=openid profile
NEXT_PUBLIC_OIDC_AUDIENCE=
# Must match the server's CLASSAPP_OIDC_ROLES_CLAIM / CLASSAPP_OIDC_TENANT_CLAIM.
NEXT_PUBLIC_OIDC_ROLES_CLAIM=roles
NEXT_PUBLIC_OIDC_TENANT_CLAIM=tenant_id
