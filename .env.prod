# class-app web — PRODUCTION. Loaded by `npm run build` / `npm run build:prod`. Replace the example hosts.
# Everything here is public (built into the pages): never put a secret in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_API_URL=https://api.example.com

# Admin console SSO. Register https://class.example.com/admin/callback as a redirect URI for
# this public client with your provider.
NEXT_PUBLIC_OIDC_ISSUER=https://sso.example.com/realms/classapp
NEXT_PUBLIC_OIDC_CLIENT_ID=classapp-admin-console
NEXT_PUBLIC_OIDC_SCOPE=openid profile
NEXT_PUBLIC_OIDC_AUDIENCE=
NEXT_PUBLIC_OIDC_ROLES_CLAIM=realm_access.roles
NEXT_PUBLIC_OIDC_TENANT_CLAIM=tenant_id
