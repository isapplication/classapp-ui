# class-app web — UAT. Loaded by `npm run build:uat`. Replace the example hosts with yours.
# Everything here is public (built into the pages): never put a secret in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_API_URL=https://api-uat.example.com

# Admin console SSO. Register https://class-uat.example.com/admin/callback as a redirect URI
# for this public client with your provider.
NEXT_PUBLIC_OIDC_ISSUER=https://sso-uat.example.com/realms/classapp
NEXT_PUBLIC_OIDC_CLIENT_ID=classapp-admin-console
NEXT_PUBLIC_OIDC_SCOPE=openid profile
NEXT_PUBLIC_OIDC_AUDIENCE=
NEXT_PUBLIC_OIDC_ROLES_CLAIM=realm_access.roles
NEXT_PUBLIC_OIDC_TENANT_CLAIM=tenant_id
